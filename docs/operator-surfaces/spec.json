{
  "version": 1,
  "adopted": "2026-09-28",
  "about": "Canonical ground truth for what the operator can see and do, independent of any one surface. Both the daemon's web dashboard and the desktop app are checked against it by tools/operator_surfaces_spec_test.py. Change THIS first, in the same PR as the route or the screen. See README.md.",
  "surfaces": [
    "dashboard",
    "app"
  ],
  "places": {
    "me": "who am I and what is mine",
    "communities": "who am I part of",
    "activity": "what happened, and what needs me"
  },
  "rules": [
    {
      "id": "reason-to-permit",
      "text": "Any act that PERMITS (approve, grant, ratify, register, delegate) carries a stated reason, recorded on the chain; refusing does not require one. The asymmetry is preserved, never inverted. Surfaces refuse an empty reason before the daemon sees it.",
      "source": "PRD_APP_GOVERNING_SURFACES.md §1a; SPRINTS_APP_SURFACES.md 1.4"
    },
    {
      "id": "already-decided-409",
      "text": "A single-shot decision answered 409 renders as 'already decided elsewhere' and re-reads; it is not shown as a failure.",
      "source": "SPRINTS_APP_SURFACES.md Sprint 1, conflict management"
    },
    {
      "id": "bound-to-rendered-evidence",
      "text": "A write whose meaning depends on state the operator reviewed sends that state, and the daemon refuses (409) if it moved. The surface shows what moved.",
      "source": "hestia #1132 (gate ratify expected)"
    },
    {
      "id": "unknown-not-fine",
      "text": "An unmeasurable answer (UNKNOWN) is never rendered as fine, never as an empty list, and never silently replaced by the last known state.",
      "source": "agent-inventory; gates verify; #1136"
    },
    {
      "id": "member-id",
      "text": "Members are identified by MEMBER id (e.g. kimi-code), never by atlas id (kimi_code_cli) or plugin directory (kimi).",
      "source": "hestia #1136"
    },
    {
      "id": "confirm-irreversible",
      "text": "An act that destroys or replaces something unrecoverable asks for explicit confirmation (typed name for deletes).",
      "source": "dashboard vault pane; #1137"
    },
    {
      "id": "no-secret-values",
      "text": "Vault values are never displayed or re-fetched; lists carry names and policy only.",
      "source": "dashboard vault pane; hestia #1123"
    },
    {
      "id": "signed-in-only",
      "text": "Operator writes are ABSENT, not disabled-looking, without an operator session.",
      "source": "SPRINTS_APP_SURFACES.md 1.5"
    }
  ],
