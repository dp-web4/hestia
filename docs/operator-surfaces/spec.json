    {
      "route": "POST /api/agents/:id/ungovern",
      "why": "removes a harness's hooks with no reason and discards its chain append (let _ = append_chain); must be hardened (required reason, record-or-undo) before ANY surface exposes it"
    },
    {
      "route": "POST /api/scope/floor",
      "why": "the society floor: the widest escalation there is; CLI/operator-only until a surface is designed for it. A read-only view is wanted"
    },
    {
      "route": "POST /api/scope/floor/remove",
      "why": "as scope/floor"
    },
    {
      "route": "POST /api/scope/reroot",
      "why": "rewrites the whole scope set; deliberately no UI"
    },
    {
      "route": "GET /api/transport/binding",
      "why": "transport bindings (#1030): no surface yet; a read-only view is wanted"
    },
    {
      "route": "POST /api/transport/binding",
      "why": "transport bindings (#1030): member/operator wiring, not yet a UI act"
    },
    {
      "route": "POST /api/transport/binding/remove",
      "why": "as transport/binding"
    },
    {
      "route": "POST /api/config/seed",
      "why": "bootstrap path for runtime config, run by deploy/installer"
    },
    {
      "route": "GET /api/trust/graph",
      "why": "no consumer yet"
    },
    {
      "route": "GET /api/scope/requests",
      "why": "both surfaces read requests from the snapshot (GET /api/dashboard) instead"
    },
    {
      "route": "POST /credential",
      "why": "wallet-facing credential issuance, not an operator surface"
    },
    {
      "route": "POST /nonce",
      "why": "wallet-facing"
    },
    {
      "route": "GET /.well-known/openid-credential-issuer",
      "why": "wallet-facing metadata"
    }
