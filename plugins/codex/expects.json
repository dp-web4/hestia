{
  "gate": [
    "PreToolUse"
  ],
  "install": {
    "member": "codex",
    "dest": "~/.codex/hooks",
    "registration": {
      "reader": "toml-hook-commands",
      "path": [
        ".codex",
        "config.toml"
      ],
      "ensure": [
        {
          "table": "features",
          "key": "codex_hooks",
          "line": "codex_hooks = true"
        }
      ]
    },
    "files": [
      "hooks/pre_tool_use.py",
      "hooks/witness.py",
      "hooks/observe.sh",
      "hooks/hydrate.sh"
    ],
    "mesh_member": "codex",
    "requires": [
      "member-mesh/session-mesh-inbox.sh",
      "member-mesh/prompt-disposition-watch.sh",
      "member-mesh/hestia-mesh.py"
    ],
    "_mesh_member_note": "#1373: this member carries the member mesh. install-members.sh installs plugins/member-mesh/RUNTIME_MANIFEST.txt's files (the two mesh hooks this member's template registers, and the CLI they call from their own directory) into the directory its harness runs the mesh hooks from, and records them in the manifest. The value is the member's mesh id, pinned on the template's mesh lines.",
    "gate_probe": {
      "entry": "hooks/pre_tool_use.py",
      "environment": {},
      "events": [
        {
          "label": "read recovery scratch",
          "event": {
            "hook_event_name": "PreToolUse",
            "session_id": "hestia-deploy-preflight",
            "tool_name": "Read",
            "tool_input": {
              "file_path": "{scratch}"
            }
          }
        },
        {
          "label": "evaluate deploy hold",
          "event": {
            "hook_event_name": "PreToolUse",
            "session_id": "hestia-deploy-preflight",
            "tool_name": "Bash",
            "tool_input": {
              "command": "touch {hold}"
            }
          },
          "advisory": true
        }
      ]
    }
  },
  "observe": [
    "PostToolUse"
  ],
  "targets": {
    "observe": [
      "witness.py"
    ]
  }
}
