{
  "gate": [
    "PreToolUse"
  ],
  "install": {
    "member": "codex",
    "dest": "~/.codex/hooks",
    "registration": {
      "reader": "toml-hook-commands",
      "path": [
        ".codex",
        "config.toml"
      ],
      "ensure": [
        {
          "table": "features",
          "key": "codex_hooks",
          "line": "codex_hooks = true"
        }
      ]
    },
    "files": [
      "hooks/pre_tool_use.py",
      "hooks/witness.py",
      "hooks/observe.sh",
      "hooks/hydrate.sh",
      "../member-mesh/session-mesh-inbox.sh",
      "../member-mesh/prompt-disposition-watch.sh"
    ],
    "companions": [
      {
        "file": "../member-mesh/hestia-mesh.py",
        "beside": "session-mesh-inbox.sh"
      }
    ],
    "_companions_note": "#1373: a companion is a file no harness registers but a registered hook calls from its own directory; install-members.sh installs it into the directory the named hook was installed to, with the same backup and verify, and records it in the manifest.",
    "mesh_member": "codex",
    "gate_probe": {
      "entry": "hooks/pre_tool_use.py",
      "environment": {},
      "events": [
        {
          "label": "read recovery scratch",
          "event": {
            "hook_event_name": "PreToolUse",
            "session_id": "hestia-deploy-preflight",
            "tool_name": "Read",
            "tool_input": {
              "file_path": "{scratch}"
            }
          }
        },
        {
          "label": "evaluate deploy hold",
          "event": {
            "hook_event_name": "PreToolUse",
            "session_id": "hestia-deploy-preflight",
            "tool_name": "Bash",
            "tool_input": {
              "command": "touch {hold}"
            }
          },
          "advisory": true
        }
      ]
    }
  },
  "observe": [
    "PostToolUse"
  ],
  "targets": {
    "observe": [
      "witness.py"
    ]
  }
}
