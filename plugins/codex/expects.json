{
  "gate": [
    "PreToolUse"
  ],
  "install": {
    "dest": "~/.codex/hooks",
    "registration": {
      "reader": "toml-hook-commands",
      "path": [
        ".codex",
        "config.toml"
      ]
    },
    "files": [
      "hooks/pre_tool_use.py",
      "hooks/witness.py",
      "hooks/observe.sh",
      "hooks/hydrate.sh"
    ]
  },
  "observe": [
    "PostToolUse"
  ]
}
