{
  "gate": [
    "PreToolUse"
  ],
  "install": {
    "dest": "~/.kimi-code/hooks",
    "registration": {
      "reader": "toml-hook-commands",
      "path": [
        ".kimi-code",
        "config.toml"
      ]
    },
    "files": [
      "hooks/pre_tool_use.py",
      "hooks/observe.sh",
      "hooks/hydrate.sh"
    ]
  },
  "observe": [
    "PostToolUse"
  ]
}
