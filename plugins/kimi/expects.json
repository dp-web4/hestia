{
  "gate": [
    "PreToolUse"
  ],
  "install": {
    "member": "kimi-code",
    "dest": "~/.kimi-code/hooks",
    "registration": {
      "reader": "toml-hook-commands",
      "path": [
        ".kimi-code",
        "config.toml"
      ],
      "layout": "flat"
    },
    "files": [
      "hooks/pre_tool_use.py",
      "hooks/witness.py",
      "hooks/observe.sh",
      "hooks/hydrate.sh"
    ],
    "gate_probe": {
      "entry": "hooks/pre_tool_use.py",
      "environment": {},
      "events": [
        {
          "label": "read recovery scratch",
          "event": {
            "hook_event_name": "PreToolUse",
            "session_id": "hestia-deploy-preflight",
            "tool_name": "Read",
            "tool_input": {
              "file_path": "{scratch}"
            }
          }
        },
        {
          "label": "evaluate deploy hold",
          "event": {
            "hook_event_name": "PreToolUse",
            "session_id": "hestia-deploy-preflight",
            "tool_name": "Bash",
            "tool_input": {
              "command": "touch {hold}"
            }
          },
          "advisory": true
        }
      ]
    }
  },
  "observe": [
    "PostToolUse",
    "PostToolUseFailure"
  ],
  "targets": {
    "observe": [
      "witness.py"
    ]
  }
}
