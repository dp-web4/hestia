{
  "gate": [
    "BeforeTool"
  ],
  "install": {
    "dest": "~/.gemini/hestia-plugins/gemini/hooks",
    "registration": {
      "reader": "json-hook-commands",
      "path": [
        ".gemini",
        "settings.json"
      ]
    },
    "files": [
      "hooks/before_tool.py",
      "hooks/observe.sh",
      "hooks/hydrate.sh"
    ]
  },
  "observe": [
    "AfterTool"
  ]
}
