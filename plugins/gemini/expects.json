{
  "gate": [
    "BeforeTool"
  ],
  "install": {
    "dest": "~/.gemini/hestia-plugins/gemini/hooks",
    "registration": {
      "reader": "json-hook-commands",
      "path": [
        ".gemini",
        "settings.json"
      ]
    },
    "files": [
      "hooks/before_tool.py",
      "hooks/observe.sh",
      "hooks/hydrate.sh"
    ],
    "gate_probe": {
      "entry": "hooks/before_tool.py",
      "environment": {},
      "events": [
        {
          "label": "read recovery scratch",
          "event": {
            "hook_event_name": "BeforeTool",
            "session_id": "hestia-deploy-preflight",
            "tool_name": "read_file",
            "tool_input": {
              "absolute_path": "{scratch}"
            }
          }
        },
        {
          "label": "evaluate deploy hold",
          "event": {
            "hook_event_name": "BeforeTool",
            "session_id": "hestia-deploy-preflight",
            "tool_name": "run_shell_command",
            "tool_input": {
              "command": "touch {hold}"
            }
          },
          "advisory": true
        }
      ]
    }
  },
  "observe": [
    "AfterTool"
  ]
}
