+    try:
+        words = shlex.split(seg, posix=True)
+    except ValueError:
+        words = seg.split()
+    for w in words:
+        if _HEREDOC_INTERPRETER.match(os.path.basename(w)):
+            return os.path.basename(w)
+    for w in words:
+        if "=" in w and not w.startswith(("-", "/", ".")) and w.split("=", 1)[0].isidentifier():
