+        # simply absent, and a known target beside it read as the whole set.
+        complete = bool(resolved) and all(
+            v.marker and v.rule == closure.RULE_WRITE
+            and isinstance(v.resolved, str) and os.path.isabs(v.resolved)
+            for v in verdicts)
