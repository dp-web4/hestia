+                                                      n=95), "registered-entry", shim_path=entry)
+            check(f"{seat}-registered-entry-bar", rec.get("bar") == "sovereign_plus_peer", rec)
+            check(f"{seat}-registered-entry-marker", rec.get("marker") == sb.REGISTERED_ENTRY_MARKER, rec)
+        finally:
