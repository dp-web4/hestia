+def _jq_data_words(toks, at) -> set:
+    """Token indexes of `jq`'s words that are NOT files, for the jq whose command word is
+    `toks[at]`: its program (the first non-option word) and the values of `--indent`/`--arg`/
+    `--argjson`. Empty unless every option word of the simple command is on the allowlist above,
+    so the program is known to be text (Codex HOLD on 8a39ac04: jq applies `-f` to the program
+    wherever it appears, `-n O/p.jq -f`, and `--rawfile --name O/f` binds `--name` as a NAME).
+    Any word that can expand into more or other words (`$X`, `$(…)`, a glob, `{a,b}`) could be
+    `-f`, so it disqualifies the whole command."""
+    words, skip = [], False
+    for i in range(at + 1, len(toks)):
+        kind, w, uglob = toks[i]
+        if kind in ("sep", "mark"):
+            break
+        if kind == "op":
+            skip = True                                    # a redirection's target is not argv
+            continue
+        if skip:
+            skip = False
+            continue
+        try:
+            if uglob or _BRACE in w or _expansion_spans(w):
+                return set()
+        except _Unmodelled:
+            return set()
+        words.append((i, w))
+    data, program, k = set(), None, 0
+    while k < len(words):
+        i, w = words[k]
+        k += 1
+        if not (w[:1] == "-" and (w[1:2] == "-" or w[1:2].isalpha())):
