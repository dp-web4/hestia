+    """#1314 part 4: `cd /abs && …` sets the directory for everything after it. If the `cd` fails,
+    `&&` runs nothing more, so no later word can resolve under the event cwd. Returns the
+    directory (resolved, so a later `..` is judged physically, as the kernel resolves it) only
+    when the WHOLE command is `cd <literal absolute dir> && …` and every later separator is `&&`
+    or a pipe. Any `;`, newline, `||`, `&`, subshell, group or command substitution (a body runs
+    as a separate statement here) keeps the event cwd as a base, as before."""
+    try:
+        toks = _shell_words(_strip_data_heredocs(cmd))
+    except _Unmodelled:
+        return None
+    if len(toks) < 4 or toks[0] != ("word", "cd", False) or toks[1][0] != "word" \
+            or toks[2] != ("sep", "&&", False):
