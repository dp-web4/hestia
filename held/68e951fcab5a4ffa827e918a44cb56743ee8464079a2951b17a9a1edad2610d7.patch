+def _url_option_frees_next(head: Optional[str], word: str) -> bool:
+    """#1314: after this option word of a URL client, is the next word an operand (True) or
+    possibly the option's value (False)? See `_URL_FLAGS`; anything not listed is a value."""
+    letters, longs = _URL_FLAGS.get(head, ("", frozenset()))
