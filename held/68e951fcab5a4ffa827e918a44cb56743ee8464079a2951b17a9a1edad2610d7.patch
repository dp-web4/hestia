+#: `--slurpfile`; `--run-tests`; `--`; an unknown one) leaves every word judged.
+_JQ_FLAGS = frozenset((
+    "--slurp", "--raw-output", "--raw-output0", "--join-output", "--compact-output",
+    "--color-output", "--monochrome-output", "--ascii-output", "--unbuffered", "--sort-keys",
+    "--raw-input", "--null-input", "--tab", "--seq", "--stream", "--stream-errors",
+    "--exit-status", "--args", "--jsonargs"))
