+#: hestia#1314 (live on McNugget, 2026-10-14): non-path text judged as a path. Every case below
+#: was a false deny of read-only work that opened peer scope requests nobody should decide.
+#:
+#: URL CLIENTS: commands whose positional arguments are URLs. For these, `host:port[/…]` is a URL
+#: too (curl and wget assume http when no scheme is given), not a relative path.
+_URL_HEADS = frozenset(("curl", "wget", "http", "https", "xh", "xhs", "curlie"))
+_HOSTPORT = re.compile(r"^(?:localhost|[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?"
+                       r"(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*|\[[0-9A-Fa-f:.]+\])"
+                       r":\d{1,5}(?:[/?#]|$)")
+_URL_WITH_SCHEME = re.compile(r"^([A-Za-z][A-Za-z0-9+.-]*)://")
+_FILE_URL = re.compile(r"^file:(?://([^/]*))?(/.*)$", re.IGNORECASE)
