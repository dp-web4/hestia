+def _network_url(value: str, head: Optional[str]) -> bool:
+    """#1314: is this literal operand of a URL client a network URL rather than a path? A scheme
+    other than `file:` (`http://127.0.0.1:8760/health`) or `host:port[/…]` (`curl
+    localhost:8760/health`). ONLY a URL client's operand: any other command may treat the word as
+    the relative path it also is, and may create it (`mkdir -p http://newdir` makes `./http:/newdir`,
+    Codex HOLD on 0a2af175). A `..` component disqualifies it: if a directory named `http:`
+    existed, `http://../x` would be a real escape. (Whether such a directory exists is checked
+    where the bases are known, in `_command_scope_reach_one`.)"""
+    if head not in _URL_HEADS or ".." in value.split("/"):
+        return False
+    m = _URL_WITH_SCHEME.match(value)
+    if m:
+        return m.group(1).lower() != "file"
+    return bool(_HOSTPORT.match(value))
