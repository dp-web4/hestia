+        for j, (r2, rec2, _m2, _k2) in enumerate(nodes):
+            if j == len(full) + i:
+                continue
+            if root == r2 or (rec2 and root.startswith(r2 + "/")):
+                return True
+    return False
+
+
+def _candidate_spellings(path: str, cwd: Optional[str]) -> tuple:
+    """``(lexical, real)`` for a candidate path, resolved the way `path_in_scope` resolves it."""
+    c = path.replace("\\", "/")
+    if c.startswith("~"):
+        c = os.path.expanduser(c).replace("\\", "/")
+    elif not c.startswith("/"):
+        c = os.path.join((cwd or os.getcwd()).replace("\\", "/"), c)
+    lex = os.path.normpath(c).replace("\\", "/").rstrip("/")
+    return lex, os.path.realpath(lex).replace("\\", "/").rstrip("/")
+
+
+def _nearest_grant(path: str, nodes, cwd: Optional[str]) -> Optional[str]:
+    """The modes of the nearest grant node covering `path` (grants on one node union), or None
+    when no grant node covers it. An exact grant covers only its own path; walking up, only
+    recursive grants apply."""
+    lex, real = _candidate_spellings(path, cwd)
+    best, held = -1, set()
+    for root, rec, modes, spelling in nodes:
+        cand = real if spelling == "real" else lex
+        if cand == root or (rec and cand.startswith(root + "/")):
+            depth = root.count("/")
+            if depth > best:
+                best, held = depth, set(modes)
+            elif depth == best:
+                held |= set(modes)
+    return None if best < 0 else "".join(m for m in GRANT_MODES if m in held)
+
+
+def _precedence_hint(near: str, need: str) -> str:
+    missing = "".join(m for m in need if m not in near)
+    return (f" The nearest grant here is narrowed to {near}; this act needs {need} (missing "
+            f"{missing}). A broader grant above it does not apply here: the nearest explicit "
+            f"grant decides (hestia #1386).")
+
+
+def _command_reached_paths(cmd: str, workspace: str, cwd: Optional[str], forbidden,
+                           home_markers) -> Optional[list]:
+    """Every path the command checker resolves for `cmd` (beyond home and temp roots), or None
+    when they cannot all be named within the gate's budget. Enumerated with the SAME resolver
+    that admits the command (`command_scope_reach`): each refusal names the path it refused, which
+    is then granted exactly (recursively, if exact is refused again) and the check re-run. No
+    second parser, so no second opinion about what a command reaches."""
