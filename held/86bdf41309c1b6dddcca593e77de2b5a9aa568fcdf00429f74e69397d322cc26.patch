+        ok, offending, refused = command_scope_reach(cmd, extra, workspace, cwd,
+                                                     forbidden=forbidden, home_markers=home_markers)
+        if ok:
+            return got
+        if (not refused or offending == _INCOMPLETE or refused.startswith(UNPRICEABLE_PREFIX)
+                or len(got) > SCOPE_JUDGE_BUDGET):
+            return None
+        if refused in got:
+            rec = "path:" + refused.rstrip("/") + RECURSIVE_SUFFIX
+            if rec in extra:
+                return None
+            extra.append(rec)
+            continue
+        got.append(refused)
+        extra.append("path:" + refused)
+    return None
+
+
+def nearest_grant_modes(policy: AgentPolicy, workspace: str, path: str,
+                        cwd: Optional[str] = None) -> Optional[str]:
+    """The gate's own answer for one path (#1386): the modes of the nearest grant covering it,
+    or None when no grant covers it. For a consumer that confines after the gate (SAGE's
+    dispatcher, its run mounts, the reach answer), so it decides exactly as the gate does."""
+    full, narrowed = _grant_nodes(list(policy.scope), list(getattr(policy, "mode_scope", ()) or ()),
+                                  workspace)
+    return _nearest_grant(path, full + narrowed, cwd)
+
