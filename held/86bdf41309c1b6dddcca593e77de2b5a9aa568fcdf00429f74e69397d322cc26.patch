+def _plain_repo_name(name) -> bool:
+    """A bare workspace-repo name (one segment), as `_scope_entry_for_grant` writes for a
+    recursive grant on `<ws>/<name>`."""
+    return (isinstance(name, str) and bool(name) and "/" not in name and "\\" not in name
+            and name not in (".", "..", AgentPolicy.UNSCOPED))
+
+
+def _grant_nodes(scopes, mode_scopes, workspace: str) -> tuple:
+    """``(full, narrowed)``: each a list of ``(root, recursive, modes, spelling)``.
+
+    `spelling` says which form of a candidate path the node is compared with, mirroring the check
+    that admits it today: "real" for `path:` roots (`_within_path_grant` compares realpaths),
+    "lex" for repo-name entries (`path_in_scope`'s segment rule is lexical)."""
+    wsl = workspace.replace("\\", "/").rstrip("/")
+    full = [(r, rec, GRANT_MODES, "real") for r, rec in _scope_roots_with_reach(list(scopes), workspace)]
+    repos, _ = _scope_parts(scopes, workspace)
+    full += [(wsl + "/" + n, True, GRANT_MODES, "lex") for n in repos if _plain_repo_name(n)]
+    narrowed = []
+    for entry, modes in mode_scopes or ():
+        if not isinstance(entry, str):
+            continue
+        if entry.startswith("path:"):
+            narrowed += [(r, rec, modes, "real") for r, rec in _scope_roots_with_reach([entry], workspace)]
+        elif _plain_repo_name(entry):
+            narrowed.append((wsl + "/" + entry, True, modes, "lex"))
+    return full, narrowed
+
+
+def _precedence_matters(full, narrowed) -> bool:
+    """Whether some narrowed grant lies at or beneath ANOTHER grant node. Only then can the nearest
+    grant differ from the union part B judges by; otherwise every check below is skipped and the
+    verdict is exactly part B's."""
