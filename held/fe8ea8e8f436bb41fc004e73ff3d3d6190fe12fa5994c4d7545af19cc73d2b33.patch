+        with open(marker, "w", encoding="utf-8") as fh:
+            fh.write("# test marker\n")
+        check("marker-resolves-from-a-child-cwd", G.detect_workspace(prof) == ws,
+              G.detect_workspace(prof))
+        os.unlink(marker)
