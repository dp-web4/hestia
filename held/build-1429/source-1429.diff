+def _raw_dir_bases(dirs, cwd: str):
+    """`_dir_bases` without `normpath` (hub's review of #1429's held patch): each `cd` destination joined
+    as the shell passes it to the kernel, so a `..` after a link is resolved AFTER the link by `realpath`.
+    Same composition and cap as `_dir_bases`; None when there are more than `_MAX_DIR_BASES`."""
+    bases = []
+    for d in dirs:
+        new = [d] if d.startswith("/") else [os.path.join(b, d) for b in [cwd] + bases]
+        for n in new:
+            n = n.replace("\\", "/")
+            if n not in bases:
+                bases.append(n)
+        if len(bases) > _MAX_DIR_BASES:
+            return None
+    return bases
