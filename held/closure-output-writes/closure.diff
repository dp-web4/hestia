+def _long_values(args: list, *names: str) -> list:
+    """Every value given to these long options, as `--name=V` or `--name V`."""
+    out = []
+    for i, a in enumerate(args):
+        for n in names:
+            if a == n and i + 1 < len(args):
+                out.append(args[i + 1])
+            elif a.startswith(n + "="):
+                out.append(a[len(n) + 1:])
+    return out
