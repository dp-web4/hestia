+def _short_cluster_value(args: list, letter: str, takes_value: str) -> list:
+    """Values of a short option `letter` that may sit in a bundled cluster (`-ro F`, `-oF`).
+    `takes_value` lists every letter of this verb that consumes a value: scanning stops at the
+    first of them, whose value is the cluster's remainder or, if none, the next argument.
+    Returns the values `letter` received (it may be given more than once)."""
+    out, i = [], 0
+    while i < len(args):
+        a = args[i]
+        if a == "--":
+            break
+        if a.startswith("-") and not a.startswith("--") and len(a) > 1:
+            body = a[1:]
+            for j, ch in enumerate(body):
+                if ch in takes_value:
+                    val = body[j + 1:]
+                    if not val and i + 1 < len(args):
+                        val = args[i + 1]
+                        i += 1
+                    if ch == letter and val:
+                        out.append(val)
+                    break
+        i += 1
+    return out
+
