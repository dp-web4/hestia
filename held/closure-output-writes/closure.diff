+        if "-x" in seen:
+            raise _OutOfGrammar()  # extraction writes the archive's members wherever they say
+        modifying = seen & {"-c", "-r", "-u", "-A", "--create", "--append", "--update",
+                            "--catenate", "--concatenate", "--delete"}
+        if modifying:
