+def _shell_without_comments(text: str) -> str:
+    out = []
+    quote = None
+    escaped = False
+    comment = False
+    word_start = True
+    for char in text:
+        if comment:
+            if char == "\n":
+                comment = False
+                word_start = True
+                out.append(char)
+            else:
+                out.append(" ")
+            continue
+        if escaped:
+            out.append(char)
+            escaped = False
+            word_start = False
+            continue
+        if quote is not None:
+            out.append(char)
+            if char == quote:
+                quote = None
+            continue
+        if char == "\\":
+            out.append(char)
+            escaped = True
+            word_start = False
+            continue
+        if char in ("'", '"'):
+            quote = char
+            out.append(char)
+            word_start = False
+            continue
+        if char == "#" and word_start:
+            comment = True
+            out.append(" ")
+            continue
+        out.append(char)
+        word_start = char.isspace() or char in ";|&()"
+    return "".join(out)
+
