+def _file_url_path(value: str) -> Optional[str]:
+    """The path a `file:` URL names (`file:///x`, `file://localhost/x`, `file:/x` -> `/x`), with
+    `%XX` decoded and any `?query` / `#fragment` dropped, as curl and sqlite3 open it; else None.
+    #1314: main judged `curl file:///etc/passwd` only as the relative `file:/etc/passwd` and
+    allowed it. The URL is ALSO an ordinary relative spelling (`cat file:///x` reads the directory
+    `file:` under the cwd), so `emit` judges both, never the target alone (Codex HOLD on 19952a05)."""
+    m = _FILE_URL.match(value)
+    if not m:
+        return None
+    path = re.split(r"[?#]", m.group(2), maxsplit=1)[0]
+    return re.sub(r"%([0-9A-Fa-f]{2})", lambda h: chr(int(h.group(1), 16)), path)
