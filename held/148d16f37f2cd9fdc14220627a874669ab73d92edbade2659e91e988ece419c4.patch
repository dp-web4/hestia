+def _sed_bundled_in_place():
+    """Use GNU or BSD sed's no-backup spelling, as appropriate for this host."""
+    try:
+        gnu = subprocess.run(
+            ["sed", "--version"], stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL, timeout=5).returncode == 0
