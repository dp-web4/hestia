+         '[[hooks.PostToolUse]]\nmatcher = "*"\n[[hooks.PostToolUse.hooks]]\ntype = "command"\n'
+         'command = "python3 {w}"\ntimeout = 20\n'),
+        ("flat", "kimi-code",
+         '[[hooks]]\nevent = "PreToolUse"\ncommand = "python3 {g}"\ntimeout = 20\n'
