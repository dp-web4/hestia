+def _ansi_c_unescape(text: str) -> str:
+    """Decode escapes that can spell path vocabulary; leave invalid sequences literal.
+
+    This only widens fallback vocabulary candidates. It never makes a command accepted
+    grammar, and its output is never executed.
+    """
+    def replace(match):
+        if match.group(5) is not None:
+            return _ANSI_C_SIMPLE[match.group(5)]
+        digits = next(g for g in match.groups()[:4] if g is not None)
+        value = int(digits, 8 if match.group(4) is not None else 16)
+        if value > 0x10FFFF or 0xD800 <= value <= 0xDFFF:
+            return match.group(0)
+        return chr(value)
+
+    return _ANSI_C_ESCAPE.sub(replace, text)
