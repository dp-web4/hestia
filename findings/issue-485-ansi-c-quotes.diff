+def test_ansi_c_fallback_false_positive_cost_485():
+    """The conservative fallback refuses these two reads; their plain forms stay reads.
+
+    This pins 2/2 visible false positives so later parser work must deliberately narrow the
+    cost. The original independent traffic scan measured 31 unquoted-$' commands in 68,288
+    Bash calls (0.045%), with zero unclassifiable commands, on one seat.
+    """
+    ansi_reads = [
+        f"grep -n $'deny' {SHARED_DIR}/{CORE}",
+        f"sed -n $'1,2p' {SHARED_DIR}/{CORE}",
+    ]
+    plain_reads = [
+        f"grep -n deny {SHARED_DIR}/{CORE}",
+        f"sed -n '1,2p' {SHARED_DIR}/{CORE}",
+    ]
+    false_positives = [cmd for cmd in ansi_reads if cls(cmd).classification == "write"]
+    check("ansi_c_fallback_cost_is_measured", len(false_positives) == 2, false_positives)
+    for cmd in plain_reads:
+        v = cls(cmd)
+        check("plain_read_control", v.classification == "read", f"{cmd}: {v}")
+
+
