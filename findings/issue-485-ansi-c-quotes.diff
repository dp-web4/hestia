+def _has_unquoted_ansi_c_quote(cmd: str) -> bool:
+    """Whether Bash sees an ANSI-C `$'` opener outside single/double quotes.
+
+    shlex has no ANSI-C quote state: inside `$'…'`, `\'` is a literal apostrophe rather than
+    the close/open sequence shlex sees. Rejecting the opener before shlex runs keeps their
+    token boundaries from silently diverging (#485). A dollar reached through backslash, or
+    inside an ordinary quoted string, is not this construct.
+    """
+    quote, i = None, 0
+    while i < len(cmd):
+        c = cmd[i]
+        if quote == "'":
+            if c == "'":
+                quote = None
+        elif quote == '"':
+            if c == "\\":
+                i += 2
+                continue
+            if c == '"':
+                quote = None
+        else:
+            if c == "\\":
+                i += 2
+                continue
+            if c == "$" and cmd.startswith("$'", i):
+                return True
+            if c in ("'", '"'):
+                quote = c
+        i += 1
+    return False
