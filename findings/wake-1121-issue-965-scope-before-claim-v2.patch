+def test_scope_refusal_precedes_self_access_claim(m, g, wc, home):
+    """#965: scope denies this governance write; the original order claims approval first."""
+    stub = Stub(Policy(claim="approve"))
+    try:
+        target = "/etc/hestia_gate_core.py"
+        tool_input = {"file_path": target, "old_string": "a", "new_string": "b"}
+        cv = g.closure.classify("Edit", tool_input, cwd=str(REPO))
+        check("scope-refusal-fixture-is-governance-write", cv.classification == "write", cv)
+        with _Env(m, stub.url, home):
+            d, _ = _decide(g, "claude-code", "Edit", tool_input, home)
+        check("scope-refusal-is-not-self-access", d.decision == "deny" and d.rule == "mrh.path", d)
+        check("scope-refusal-never-claims-self-access",
+              stub.named("hestia_gate_escalation_claim") == [], stub.calls)
+        check("scope-refusal-has-no-approval-notice",
+              not any("gate write APPROVED" in n for n in d.notices), d.notices)
+    finally:
+        stub.close()
+
