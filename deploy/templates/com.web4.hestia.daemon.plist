<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd user agent for the Hestia daemon on macOS.

  Install: copy to ~/Library/LaunchAgents/com.web4.hestia.daemon.plist and
  run `launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.web4.hestia.daemon.plist`.

  The label is com.web4.hestia.daemon because that is what hestia-deploy restarts
  (LAUNCHD_LABEL's default) and what the fleet's Mac has run since 2026-05-21. This template
  was `io.hestia.tools` until 2026-09-28: a seat installed from it was one hestia-deploy could
  not restart without HESTIA_LAUNCHD_LABEL set by hand.

  The passphrase file lives at $HOME/.hestia/.passphrase (mode 600).
  This is the consumer-tier security boundary; Hardbound replaces it
  with Secure Enclave unsealing.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.web4.hestia.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>HESTIA_PASSPHRASE="$(cat $HOME/.hestia/.passphrase)" exec $HOME/.local/bin/hestia serve --bind 127.0.0.1:7711</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HESTIA_HOME</key>
    <string>__HESTIA_HOME__</string>
    <key>HESTIA_CURRENT_BUILD_FILE</key>
    <string>__HESTIA_HOME__/current-build.json</string>
    <!-- Optional workspace handed to agent-inventory for the dashboard read list, exactly as
         in hestia.service. It was missing HERE ONLY, so on every launchd seat the daemon's
         /api/agents could not find the inventory and answered UNKNOWN (McNugget,
         2026-09-19). Empty means the inventory reports unknown rather than guessing. -->
    <key>HESTIA_WORKSPACE</key>
    <string></string>
    <key>RUST_LOG</key>
    <string>warn</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>__HESTIA_HOME__/hestia.log</string>
  <key>StandardErrorPath</key>
  <string>__HESTIA_HOME__/hestia.err</string>
</dict>
</plist>
