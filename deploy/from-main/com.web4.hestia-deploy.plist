<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd equivalent of hestia-deploy.service + hestia-deploy.timer for a macOS seat.
  Install via the sed line in README.md (replaces __HOME__ and __UID__; launchd expands neither).

  StartCalendarInterval, not StartInterval: the policy is a FIXED wall clock (xx:17 every 4h)
  that anyone running a daemon-dependent test can read; StartInterval is relative to load and
  drifts across reboots and sleeps. On a laptop that slept through marks, launchd coalesces the
  missed ones into one catch-up run.

  Written from mcnugget's measurements (2026-08-27), untested on a macOS seat: see README.md.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.web4.hestia-deploy</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/hestia-deploy</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>HESTIA_HOME</key>
    <string>__HOME__/.hestia</string>
    <!-- the file the daemon's plist execs; the script refuses to run if this is wrong -->
    <key>HESTIA_BIN</key>
    <string>/opt/homebrew/bin/hestia</string>
    <!-- used for the deploy restart AND the rollback restart -->
    <key>HESTIA_RESTART_CMD</key>
    <string>launchctl kickstart -k gui/__UID__/com.web4.hestia.daemon</string>
    <key>PATH</key>
    <string>__HOME__/.cargo/bin:__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>17</integer></dict>
    <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>17</integer></dict>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>17</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>17</integer></dict>
    <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>17</integer></dict>
    <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>17</integer></dict>
  </array>

  <!-- yield to the daemon, as Nice=15 does in the systemd unit -->
  <key>Nice</key>
  <integer>15</integer>
  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>__HOME__/.hestia/deploy.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.hestia/deploy.launchd.log</string>
</dict>
</plist>
